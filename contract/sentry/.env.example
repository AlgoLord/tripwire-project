# Dedicated verifier key. Never use the NEAR contract administrator's key.
SENTRY_PRIVATE_KEY=ed25519:REPLACE_WITH_DEDICATED_SECRET_KEY
# Must exactly match verifier_pk returned by get_config on the deployed contract.
SENTRY_EXPECTED_PUBLIC_KEY=ed25519:REPLACE_WITH_PUBLIC_KEY_FROM_GET_CONFIG
# Exact initialized NEAR testnet contract account.
TRIPWIRE_CONTRACT_ID=REPLACE_WITH_EXACT_CONTRACT_ACCOUNT
NEAR_RPC_URL=https://rpc.testnet.near.org
